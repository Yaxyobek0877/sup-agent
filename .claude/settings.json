{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(python3 --version)",
      "Bash(python --version)",
      "Bash(git --version)",
      "Bash(uname:*)",
      "Bash(whoami)",
      "Bash(hostname)",
      "Bash(sw_vers:*)",
      "Bash(ls:*)",
      "Bash(cat config.example.json)",
      "Bash(cat VERSION)",
      "Bash(cat README.md)",
      "Bash(grep:*)",
      "Bash(findstr:*)",
      "Bash(tail:*)",
      "Bash(apt install -y python3 git)",
      "Bash(sudo apt install -y python3 git)",
      "Bash(sudo apt-get install -y python3 git)",
      "Bash(brew install git)",
      "Bash(git clone https://github.com/Yaxyobek0877/sup-agent.git:*)",
      "Bash(sudo git clone https://github.com/Yaxyobek0877/sup-agent.git:*)",
      "Bash(sudo chown -R:*)",
      "Bash(bash install.sh)",
      "Bash(git -C:*)",
      "Bash(git remote -v)",
      "Bash(git status:*)",
      "Bash(cp config.example.json config.json)",
      "Bash(python3 setup_config.py)",
      "Bash(python setup_config.py)",
      "Bash(chmod 600 config.json)",
      "Bash(python3 node.py --once)",
      "Bash(python node.py --once)",
      "Bash(sudo tee /etc/systemd/system/sup-agent.service)",
      "Bash(sudo systemctl daemon-reload)",
      "Bash(sudo systemctl enable --now sup-agent)",
      "Bash(sudo systemctl enable sup-agent)",
      "Bash(systemctl is-enabled sup-agent)",
      "Bash(systemctl is-active sup-agent)",
      "Bash(sudo systemctl kill -s KILL sup-agent)",
      "Bash(sudo systemctl restart sup-agent)",
      "Bash(systemd-analyze verify:*)",
      "Bash(journalctl -u sup-agent:*)",
      "Bash(launchctl load:*)",
      "Bash(launchctl list:*)",
      "Bash(schtasks /Create:*)",
      "Bash(schtasks /Run:*)",
      "Bash(schtasks /Query:*)",
      "Write(//**/Library/LaunchAgents/uz.1pro.supagent.plist)"
    ],
    "deny": [
      "Bash(reboot)",
      "Bash(sudo reboot)",
      "Bash(shutdown:*)",
      "Bash(sudo shutdown:*)",
      "Bash(halt:*)",
      "Bash(sudo halt:*)",
      "Bash(poweroff:*)",
      "Bash(systemctl reboot)",
      "Bash(systemctl poweroff)",
      "Bash(sudo systemctl reboot)",
      "Bash(sudo systemctl poweroff)",
      "Bash(init 0)",
      "Bash(init 6)",
      "Bash(ufw:*)",
      "Bash(sudo ufw:*)",
      "Bash(iptables:*)",
      "Bash(sudo iptables:*)",
      "Bash(nft:*)",
      "Bash(sudo nft:*)",
      "Bash(setenforce:*)",
      "Bash(sudo setenforce:*)",
      "Bash(mkfs:*)",
      "Bash(sudo mkfs:*)",
      "Bash(dd:*)",
      "Bash(sudo dd:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(sudo rm -rf /)",
      "Bash(sudo rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /etc:*)",
      "Bash(rm -rf /var:*)",
      "Bash(rm -rf /usr:*)",
      "Bash(sudo rm -rf /etc:*)",
      "Bash(sudo rm -rf /var:*)",
      "Bash(sudo rm -rf /usr:*)",
      "Bash(git add -f:*)",
      "Bash(git add config.json)",
      "Bash(cat config.json)",
      "Bash(cat ./config.json)",
      "Read(config.json)",
      "Read(//**/config.json)"
    ]
  }
}
